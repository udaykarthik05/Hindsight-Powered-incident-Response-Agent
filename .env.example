# ==============================================================================
# Hindsight-Powered Incident Response Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.
# Note: NEVER commit real API keys or secrets into source control.

# Application Configuration
APP_NAME="Hindsight Incident Response Agent"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT=8000
DEBUG=true
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Hindsight Memory Configuration
# ------------------------------------------------------------------------------
# For local instance: Run via Docker:
#   docker run -p 8888:8888 -p 5432:5432 vectorize/hindsight:latest
# For Hindsight Cloud:
#   https://api.hindsight.vectorize.io (requires HINDSIGHT_API_KEY)
HINDSIGHT_BASE_URL="http://localhost:8888"
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="incident-response-bank"
HINDSIGHT_TIMEOUT=10.0

# LLM Reasoning Engine Configuration (Groq / OpenAI-compatible)
# ------------------------------------------------------------------------------
# Provider: 'groq' (uses Groq's high-speed OpenAI-compatible inference API)
# Model: 'openai/gpt-oss-20b' (Free open-weight reasoning model hosted on Groq)
# If LLM_API_KEY / GROQ_API_KEY is left empty, the agent gracefully runs its built-in
# heuristic reasoning engine without crashing.
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-oss-20b"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_TEMPERATURE=0.2

